			"contents": "<!-- Price Summary Sidebar -->\n        <div class=\"col-lg-4\">\n            <div class=\"sv-price-summary\">\n                <h5><i class=\"bi bi-receipt\"></i> Price Breakdown</h5>\n\n                <?php\n                $currency    = $selectedOffer['currency'] ?: 'USD';\n                $basePrice   = (float)($selectedOffer['basePrice'] ?? 0);\n                $totalTaxes  = (float)($selectedOffer['taxes'] ?? 0);\n                $totalFees   = (float)($selectedOffer['fees'] ?? 0);\n                $totalPrice  = (float)($selectedOffer['totalPrice'] ?? 0);\n                $breakdown   = $selectedOffer['priceBreakdown'] ?? [];\n\n                // Per-passenger breakdown from BestCombinablePrice/PriceBreakdown\n                $paxBreakdowns = [];\n                $individualTaxes = [];\n                foreach ($breakdown as $pb) {\n                    $qty  = $pb['quantity'] ?? 1;\n                    $ptc  = $pb['requestedPassengerType'] ?? 'ADT';\n                    $amt  = $pb['Amount'] ?? [];\n                    $pbBase  = (float)($amt['Base'] ?? 0);\n                    $pbTotal = (float)($amt['Total'] ?? 0);\n                    $pbTaxTotal = 0;\n                    $taxes = [];\n\n                    // Individual taxes\n                    if (isset($amt['Taxes']['Tax'])) {\n                        foreach ($amt['Taxes']['Tax'] as $tax) {\n                            $taxCode  = $tax['taxCode'] ?? '';\n                            $taxValue = (float)($tax['value'] ?? 0);\n                            $pbTaxTotal += $taxValue;\n                            $taxes[] = ['code' => $taxCode, 'value' => $taxValue];\n                        }\n                    }\n                    $pbTaxes = (float)($amt['Taxes']['TotalTaxes'] ?? $pbTaxTotal);\n                    $pbFees  = (float)($amt['Fees']['TotalFees'] ?? 0);\n\n                    // Surcharges\n                    $surcharges = 0;\n                    if (isset($pb['Surcharges']['TotalSurcharges'])) {\n                        $surcharges = (float)$pb['Surcharges']['TotalSurcharges'];\n                    }\n\n                    $paxBreakdowns[] = [\n                        'ptc' => $ptc, 'qty' => $qty, 'base' => $pbBase,\n                        'taxes' => $pbTaxes, 'fees' => $pbFees, 'total' => $pbTotal,\n                        'surcharges' => $surcharges, 'taxDetails' => $taxes,\n                    ];\n\n                    // Merge individual taxes\n                    foreach ($taxes as $t) {\n                        if (!isset($individualTaxes[$t['code']])) {\n                            $individualTaxes[$t['code']] = 0;\n                        }\n                        $individualTaxes[$t['code']] += $t['value'] * $qty;\n                    }\n                }\n\n                // Fallback: use offer-level data if no PriceBreakdown\n                if (empty($paxBreakdowns) && $totalPrice > 0) {\n                    $paxBreakdowns[] = [\n                        'ptc' => 'ADT', 'qty' => $params['adults'] ?? 1,\n                        'base' => $basePrice, 'taxes' => $totalTaxes,\n                        'fees' => $totalFees, 'total' => $totalPrice,\n                        'surcharges' => 0, 'taxDetails' => [],\n                    ];\n                }\n\n                $ptcLabels = ['ADT' => 'Adult', 'CNN' => 'Child', 'INF' => 'Infant', 'CHD' => 'Child'];\n                ?>\n\n                <!-- Per-passenger type breakdown -->\n                <?php foreach ($paxBreakdowns as $pb): ?>\n                    <div class=\"mb-2 pb-2\" style=\"border-bottom:1px solid rgba(255,255,255,0.1)\">\n                        <div class=\"d-flex justify-content-between\" style=\"font-size:.82rem;opacity:.8\">\n                            <span><?= $pb['qty'] ?> × <?= $ptcLabels[$pb['ptc']] ?? $pb['ptc'] ?></span>\n                            <span><?= formatCurrency($pb['total'], $currency) ?></span>\n                        </div>\n                    </div>\n                <?php endforeach; ?>\n\n                <!-- Base Fare -->\n                <?php if ($basePrice > 0): ?>\n                    <div class=\"price-row\"><span>Base Fare</span><span><?= formatCurrency($basePrice, $currency) ?></span></div>\n                <?php endif; ?>\n\n                <!-- Individual Tax Breakdown -->\n                <?php if (!empty($individualTaxes)): ?>\n                    <div style=\"font-size:.78rem;opacity:.75;padding-top:.2rem\">\n                        <?php\n                        $taxNames = [\n                            'GB'=>'UK Air Passenger Duty','UB'=>'UK Passenger Service Charge','YQ'=>'Carrier Surcharge',\n                            'YR'=>'Carrier Surcharge','F6'=>'Passenger Facility Charge','ZR'=>'International Surcharge',\n                            'OW'=>'Security Charge','XA'=>'APHIS Fee','XY'=>'Immigration Fee','US'=>'US Transportation Tax',\n                            'AY'=>'Sept 11 Security Fee','XF'=>'Passenger Facility Charge','IN'=>'India GST',\n                            'WO'=>'India Passenger Service Fee','K3'=>'India User Dev Fee','P2'=>'India Aviation Security Fee',\n                        ];\n                        ?>\n                        <?php foreach ($individualTaxes as $code => $val): ?>\n                            <div class=\"d-flex justify-content-between py-1\" style=\"border-bottom:1px solid rgba(255,255,255,0.06)\">\n                                <span><?= htmlspecialchars($code) ?> <?= isset($taxNames[$code]) ? '— ' . $taxNames[$code] : '' ?></span>\n                                <span><?= formatCurrency($val, $currency) ?></span>\n                            </div>\n                        <?php endforeach; ?>\n                    </div>\n                <?php elseif ($totalTaxes > 0): ?>\n                    <div class=\"price-row\"><span>Taxes &amp; Fees</span><span><?= formatCurrency($totalTaxes, $currency) ?></span></div>\n                <?php endif; ?>\n\n                <!-- Fees -->\n                <?php if ($totalFees > 0): ?>\n                    <div class=\"price-row\"><span>Fees</span><span><?= formatCurrency($totalFees, $currency) ?></span></div>\n                <?php endif; ?>\n\n                <!-- Surcharges -->\n                <?php\n                $totalSurcharges = 0;\n                foreach ($paxBreakdowns as $pb) $totalSurcharges += $pb['surcharges'] * $pb['qty'];\n                ?>\n                <?php if ($totalSurcharges > 0): ?>\n                    <div class=\"price-row\"><span>Surcharges</span><span><?= formatCurrency($totalSurcharges, $currency) ?></span></div>\n                <?php endif; ?>\n\n                <!-- Grand Total -->\n                <div class=\"price-total\">\n                    <span>Total</span>\n                    <span><?= formatCurrency($totalPrice, $currency) ?></span>\n                </div>",
